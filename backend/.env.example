# Required
DATABASE_URL=postgresql://pgmanager_app:replace-me@localhost:5432/pgmanager
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional
PORT=5000
NODE_ENV=development
# For a local development database, set DB_SSL=false.
# For Amazon RDS in production, set DB_SSL=true and DB_SSL_CA to the downloaded
# AWS RDS global CA bundle path, e.g. /etc/ssl/certs/rds-global-bundle.pem.
DB_SSL=false
# Local development may use automatic schema/admin initialization. In production,
# run "npm run init-db" once using an admin database URL, then leave this unset/false.
