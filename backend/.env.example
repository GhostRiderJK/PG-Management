# --- required ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/pgmanager
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
ADMIN_EMAIL=admin@pg.local
ADMIN_PASSWORD=Admin@12345

# --- optional ---
PORT=5000
NODE_ENV=development
# set true when the database needs SSL (Neon, Render, RDS with force_ssl)
DB_SSL=false
# cookies are Secure (HTTPS only) in production; set false only for plain-http testing
COOKIE_SECURE=true
